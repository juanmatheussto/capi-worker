NODE_ENV=development
PORT=8080
LOG_LEVEL=info
WORKER_CONCURRENCY=5

# Postgres
DATABASE_URL=postgres://capi:capi@localhost:5432/capi

# Redis
REDIS_URL=redis://localhost:6379

# Graph API
GRAPH_API_VERSION=v21.0
# Fallback usado quando o tenant nao tem credencial propria no banco:
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# WhatsApp Cloud API (webhook oficial da Meta)
# WA_VERIFY_TOKEN: string que voce inventa e repete no painel da Meta (handshake do GET)
# META_APP_SECRET: App Secret do app da Meta, em Configuracoes > Basico
WA_VERIFY_TOKEN=
META_APP_SECRET=

# Chave para as rotas administrativas (POST /tenants, POST /events, GET /tenants/:id/events)
ADMIN_API_KEY=troque-isto

# URL pública deste serviço — usada para auto-configurar o webhook na Evolution
PUBLIC_BASE_URL=

# Basic Auth do dashboard + rotas /tenants/* (formato "usuario:senha"). Vazio = sem auth.
DASH_BASIC_AUTH=

# Cria um tenant no primeiro boot se não existir (deixe vazio para não criar)
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_WEBHOOK_SECRET=

# Regras
EVENT_MAX_AGE_DAYS=7
CTWA_ATTRIBUTION_WINDOW_HOURS=72
DEFAULT_EVENT_NAME=JoinGroup
