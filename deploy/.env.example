# domínio que aponta (registro A) para o IP desta VPS
CADDY_DOMAIN=capi.dutraviagens.com.br

# Basic Auth do dashboard (a app faz, não o Caddy). Formato "usuario:senha".
DASH_BASIC_AUTH=admin:trocaSenhaForte

# chave das rotas admin do capi-worker (o dashboard manda em x-api-key)
ADMIN_API_KEY=troque-por-uma-chave-longa-aleatoria

# apikey GLOBAL do Evolution (usada para criar instâncias)
EVOLUTION_API_KEY=troque-por-outra-chave-longa-aleatoria

# cria o tenant já no primeiro boot (evita o curl de bootstrap)
BOOTSTRAP_TENANT_ID=dutra
BOOTSTRAP_TENANT_NAME=Dutra Viagens
BOOTSTRAP_WEBHOOK_SECRET=troque-por-um-segredo-de-webhook
